# Inkloom Sentinel - Environment Configuration Template
# Copy this file to .env for local development:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# IMPORTANT: Never commit actual secrets or production credentials to source control.

# Application Environment: 'development', 'staging', 'production', 'test'
ENVIRONMENT=development
DEBUG=true
APP_NAME="Inkloom Sentinel API"
APP_VERSION="0.1.0"
API_V1_PREFIX=/api/v1

# Server Binding
HOST=127.0.0.1
PORT=8000

# Security & Secrets
# Generate a cryptographically secure key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long
ALLOWED_HOSTS=["127.0.0.1", "localhost"]
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration
# Default local SQLite async URL for zero-friction local development/testing:
DATABASE_URL=sqlite+aiosqlite:///./inkloom_sentinel.db
# For PostgreSQL in staging/production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inkloom_sentinel

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Logging Configuration: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Structured JSON logs (true for cloud/staging/production, false for readable colored console)
LOG_JSON_FORMAT=false
