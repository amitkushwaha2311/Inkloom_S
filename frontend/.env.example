# Inkloom Sentinel — Frontend Environment Variables
# Copy this file to .env.local for local development
# For production builds on Vercel: set these as Build Environment Variables
# in the Vercel project dashboard (Settings → Environment Variables)

# REQUIRED for production:
# Set to the full HTTPS URL of your deployed Render backend.
# Example: VITE_API_BASE_URL=https://inkloom-sentinel-api.onrender.com
# Leave empty ("") if frontend and backend are served from the same origin.
VITE_API_BASE_URL=
